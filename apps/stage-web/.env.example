# Copy this file to `.env.local` and fill the values.
#
# The knowledge base settings page reads these values as the defaults for a new
# connection. `VITE_KNOWLEDGE_BASE_API_KEY` is a secret. Keep the real value in
# `.env.local`, which git ignores, and never in this file.
VITE_KNOWLEDGE_BASE_URL=
VITE_KNOWLEDGE_BASE_API_KEY=

# The application writes these values into browser storage at the first start,
# so a new visitor uses your backend without any setup.
#
# VITE_DEFAULT_CONFIG_VERSION switches the defaults on and re-applies them after
# you change it. Leave it empty to disable the whole block.
#
# An empty URL leaves that provider alone. `VITE_DEFAULT_SPEECH_API_KEY` is a
# secret for a paid cloud provider: do not set it. Point the provider at a
# server that holds the key instead.
VITE_DEFAULT_CONFIG_VERSION=
VITE_DEFAULT_LLM_BASE_URL=
VITE_DEFAULT_LLM_MODEL=
VITE_DEFAULT_LLM_API_KEY=
VITE_DEFAULT_SPEECH_BASE_URL=
VITE_DEFAULT_SPEECH_MODEL=
VITE_DEFAULT_SPEECH_VOICE=
VITE_DEFAULT_SPEECH_API_KEY=

# A second chat source that the application offers next to the default one. The
# record carries the key only: the runtime reads the model list from the API.
# A model name here makes DeepSeek the chat source that a new visitor starts
# with. Leave it empty to keep the source above as the default.
VITE_DEFAULT_DEEPSEEK_API_KEY=
VITE_DEFAULT_DEEPSEEK_MODEL=

# The display model that a new visitor starts with. Use the id of a model in
# `displayModelsPresets`, for example `preset-live2d-chun-nurse`, or the id of a
# model that this application registers.
VITE_DEFAULT_DISPLAY_MODEL=

# Drops the provider records that a browser stores, once per value. Raise it
# after you rotate a provider credential: the application never replaces a
# provider record that already exists, so without this every earlier browser
# keeps the invalid key and chat fails with an upstream 401.
#
# This also discards a provider that a visitor added. Leave it empty in a public
# build, where the key must not reach the browser at all.
VITE_PROVIDER_PURGE_VERSION=

# Set to a truthy value when the deployment runs no mods server channel.
# The channel is a local WebSocket (`ws://localhost:6121/ws`) that powers mods
# and remote control. Without this flag every visitor attempts that connection,
# fails, and the browser console fills with retry errors.
VITE_DISABLE_SERVER_CHANNEL=
