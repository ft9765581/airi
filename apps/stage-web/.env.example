# Copy this file to `.env.local` and fill the values.
#
# The knowledge base settings page reads these values as the defaults for a new
# connection. `VITE_KNOWLEDGE_BASE_API_KEY` is a secret. Keep the real value in
# `.env.local`, which git ignores, and never in this file.
VITE_KNOWLEDGE_BASE_URL=
VITE_KNOWLEDGE_BASE_API_KEY=
