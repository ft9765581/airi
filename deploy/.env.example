# 复制成 .env 再改：cp .env.example .env
#
# 三个密钥必须自己生成，不要用这里的示例值：
#   openssl rand -base64 32   -> BETTER_AUTH_SECRET
#   openssl rand -base64 32   -> LLM_ROUTER_MASTER_KEY（必须正好 32 字节的 base64）
#   openssl rand -hex 24      -> POSTGRES_PASSWORD / REDIS_PASSWORD

# 主应用域名，前端和 api 共用同一个域名
APP_DOMAIN=example.com
# 账号界面域名，和主应用必须不同（两个前端都用 /assets/ 路径）
ACCOUNTS_DOMAIN=accounts.example.com

# 数据库。密码只能用字母、数字和 -，因为它会被拼进 DATABASE_URL
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-url-safe
REDIS_PASSWORD=change-me-too

# 认证服务签名密钥
BETTER_AUTH_SECRET=

# 上游模型凭证的加密主密钥
LLM_ROUTER_MASTER_KEY=

# enforce = 需要 Flux 余额；off = 免费不限
OPENAI_GATEWAY_BILLING_MODE=off

# 邮件（可选）。不填则不发验证邮件，注册后直接可用
RESEND_API_KEY=
