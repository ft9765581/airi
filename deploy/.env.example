# 复制成 .env 再改：cp .env.example .env
#
# 三个密钥必须自己生成，不要用这里的示例值：
#   openssl rand -base64 32   -> BETTER_AUTH_SECRET
#   openssl rand -base64 32   -> LLM_ROUTER_MASTER_KEY（必须正好 32 字节的 base64）
#   openssl rand -hex 24      -> POSTGRES_PASSWORD / REDIS_PASSWORD

# 主应用域名，前端和 api 共用同一个域名
APP_DOMAIN=example.com
# 账号界面域名。只有把账号界面单独部署成另一个站点时才需要它（用于信任来源列表）。
# 用主域自带的 /ui 页面做登录时，这一项不参与登录跳转。
ACCOUNTS_DOMAIN=accounts.example.com

# 登录页地址（auth 服务把 /auth/* 重定向到这里）。必填。
#
# 同域（推荐）：主站源码里本来就带整套登录/注册页面（/ui/sign-in、/ui/profile…），
#   品牌一致、不跨站，登录完成后回到 /auth/callback 无感：
#     AUTH_UI_URL=https://你的主域/ui
# 独立账号站：把账号界面单独部署后填它：
#     AUTH_UI_URL=https://你的账号域/ui
AUTH_UI_URL=https://example.com/ui

# 数据库。密码只能用字母、数字和 -，因为它会被拼进 DATABASE_URL
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-url-safe
REDIS_PASSWORD=change-me-too

# 认证服务签名密钥
BETTER_AUTH_SECRET=

# 上游模型凭证的加密主密钥
LLM_ROUTER_MASTER_KEY=

# enforce = 需要 Flux 余额；off = 免费不限
OPENAI_GATEWAY_BILLING_MODE=off

# API-owned knowledge base proxy. The browser calls /api/v1/knowledge-base/retrieval.
KNOWLEDGE_BASE_URL=https://knowledge.bestmings.com/api/dify/retrieval
KNOWLEDGE_BASE_API_KEY=
# `dify` speaks the external knowledge contract. `demo` reads the same content
# through the service's read-only search route, for a deployment whose external
# endpoint answers 2001 for every knowledge id.
KNOWLEDGE_BASE_PROVIDER=dify
# Read only when the provider is `demo`: the service appends
# `/knowledge-bases/{id}/search` to this base URL.
KNOWLEDGE_BASE_DEMO_BASE_URL=
# How long one retrieval may run before the API reports a timeout.
KNOWLEDGE_BASE_TIMEOUT_MS=8000

# 邮件（可选）。不填则不发验证邮件，注册后直接可用
RESEND_API_KEY=
